# Copy to .env (git-ignored) and fill in real values for docker-compose.
# These must be freshly rotated credentials — the old ones that used to be
# hardcoded in appsettings.json/Program.cs are compromised and must not be reused.

EMAIL_FROM=
EMAIL_USERNAME=
EMAIL_PASSWORD=

# Local dev MySQL root password (also used by docker-compose's db service).
DB_ROOT_PASSWORD=

# JWT signing key — generate with `openssl rand -hex 32`.
JWT_SECRET_KEY=
